#!/usr/bin/env bashio
# shellcheck shell=bash
set -Eeuo pipefail

mkdir -p /run/hermes-ha
if [[ ! -f /run/hermes-ha/home-assistant-render-upstream.conf ]]; then
  echo 'set $ha_frontend_upstream "http://127.0.0.1:8123";' > /run/hermes-ha/home-assistant-render-upstream.conf
fi

bashio::log.info 'Starting the authenticated Ingress reverse proxy'
exec nginx -c /etc/nginx/nginx.conf -g 'daemon off;'
